# Passwort für den Admin-Bereich (Spezialbuilds mit abweichenden Funkparametern).
# Leer lassen = Admin-Bereich komplett deaktiviert.
ADMIN_PASSWORD=

# Vorausgewählte Firmware-Version. Im Webinterface kann der Benutzer davon
# abweichen. Erlaubt sind:
#   2.7               neueste Version der 2.7er-Reihe (empfohlen)
#   latest            neuester Tag überhaupt
#   v2.7.26.54e0d8d   genau dieser Tag
FIRMWARE_REF=2.7
FIRMWARE_REPO=https://github.com/meshtastic/firmware.git

# HTTP - hier hängt der Reverse Proxy dran
PORT=3336

# HTTPS mit self-signed Zertifikat - für Direktzugriff ohne Proxy.
# Web Serial (das Flashen) braucht zwingend HTTPS oder localhost.
PORT_TLS=3337
TLS_HOST=localhost
